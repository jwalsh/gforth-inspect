{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resources/stacks-log.schema.json",
  "title": "gforth stacks log record",
  "description": "One line of $XDG_STATE_HOME/sicpminus/stacks.jsonl. Producer: forth/env/inspect.fs (log-on). Consumer: course-forth-dashboard in course.el. Prose: resources/stacks-log.org.",
  "x-version": 1,
  "type": "object",
  "required": ["v", "event", "t"],
  "properties": {
    "v": { "const": 1 },
    "event": { "enum": ["hello", "snapshot"] },
    "t": { "type": "integer", "description": "Unix seconds" }
  },
  "oneOf": [
    {
      "properties": {
        "event": { "const": "hello" },
        "gforth": { "type": "string" }
      },
      "required": ["gforth"]
    },
    {
      "properties": {
        "event": { "const": "snapshot" },
        "where": { "type": ["string", "null"] },
        "src": { "type": ["string", "null"] },
        "data": { "type": "array", "items": { "type": "integer" } },
        "float": { "type": "array", "items": { "type": ["number", "null"] } },
        "rs": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "integer" },
              { "const": "sp" },
              {
                "type": "object",
                "required": ["word", "off"],
                "properties": {
                  "word": { "type": "string" },
                  "off": { "type": "integer" }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "input": {
          "type": "object",
          "required": ["file", "line", "in", "text"],
          "properties": {
            "file": { "type": "string" },
            "line": { "type": "integer" },
            "in": { "type": "integer" },
            "text": { "type": "string" }
          }
        }
      },
      "required": ["where", "src", "data", "float", "rs", "input"]
    }
  ]
}
