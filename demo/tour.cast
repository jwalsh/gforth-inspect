[1e-05, "o", "\r\ngforth-inspect 0.4.0  (log contract 1.2)\r\n\r\n1  every stack:          1 2 3  1.5e  .stacks\r\n2  inside a definition:  10 20 avg .\r\n3  nested calls:         3 4 sum-sq .\r\n4  return stack:         deeper\r\n5  floats:               3e 4e hyp f.   then   1e 0e f/ -0e .stacks fclearstack\r\n6  control flow at compile time:  : t 0 IF BEGIN .cs AGAIN THEN ;\r\n7  plain ~~ shows everything:     all-~~  : t2 ~~ ;  5 t2 drop\r\n8  tag the next snapshots:        s\" step-8\" log-id  7 .stacks drop  s\" \" log-id\r\n9  step through a word:           dbg+  dbg classify   (keys: Enter step, n nest, c continue)\r\n\r\ntour  prints this again.  log-where  shows the log file.  bye  quits.\r\nGforth 0.7.3, Copyright (C) 1995-2008 Free Software Foundation, Inc.\r\nGforth comes with ABSOLUTELY NO WARRANTY; for details type `license'\r\nType `bye' to exit\r\n"]
[1.391831, "o", "1 2 3  1.5e  .stacks  clearstack fclearstack data   <3> 1 2 3 \r\nfloat  <1> 1.500000000000E0 \r\nreturn <R:16> top first\r\n  ... interpreter (rs-full on to see it)\r\ninput  :1 >in=21\r\n1 2 3  1.5e  .stacks  clearstack fclearstack\r\n                     ^\r\n ok\r\n"]
[2.802238, "o", "10 20 avg . \r\ntour.fs:5 in avg \r\ndata   <1> 30 \r\nfloat  <0> \r\nreturn <R:17> top first\r\n  ... interpreter (rs-full on to see it)\r\ninput  :2 >in=10\r\n10 20 avg .\r\n          ^\r\n15  ok\r\n"]
[4.215078, "o", "3 4 sum-sq . \r\ntour.fs:7 in sum-sq \r\ndata   <1> 25 \r\nfloat  <0> \r\nreturn <R:17> top first\r\n  ... interpreter (rs-full on to see it)\r\ninput  :3 >in=11\r\n3 4 sum-sq .\r\n           ^\r\n25  ok\r\n"]
[5.625395, "o", "deeper <R:18> top first\r\n  $149059258 = deeper +32\r\n  ... interpreter (rs-full on to see it)\r\n ok\r\n"]
[7.041054, "o", "1e 0e f/  -0e  .stacks  fclearstack data   "]
[7.041764, "o", "<0> \r\nfloat  <2> inf              0.000000000000E0 \r\nreturn <R:16> top first\r\n  ... interpreter (rs-full on to see it)\r\ninput  :5 >in=23\r\n1e 0e f/  -0e  .stacks  fclearstack\r\n                       ^\r\n ok\r\n"]
[8.456038, "o", ": t 0 IF BEGIN .cs AGAIN THEN ; \r\nCS: here=$149059D60 \r\n  dest $149059D60  (0 cells back)\r\n  orig (live) $149059D58  (1 cells back) | colon-sys\r\n ok\r\n"]
[9.868969, "o", "s\" step-8\" log-id  7 .stacks drop  s\" \" log-id data   <1> 7 \r\nfloat  <0> \r\nreturn <R:16> top first\r\n  ... interpreter (rs-full on to see it)\r\ninput  :7 >in=29\r\ns\" step-8\" log-id  7 .stacks drop  s\" \" log-id\r\n                             ^\r\n ok\r\n"]
[11.279879, "o", "bye \r\n"]
[11.280419, "o", "\r\n$ jq -c '{e:.event,w:.where,d:.data,f:.float,id:.id}' log/stacks.jsonl\r\n"]
[12.701363, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"e\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"hello\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"w\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"d\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"f\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m\"e\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"snapshot\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"w\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"d\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[\u001b[0;39m1\u001b[0m\u001b[1;39m,\u001b[0;39m2\u001b[0m\u001b[1;39m,\u001b[0;39m3\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"f\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[\u001b[0;39m1.5000000000000000\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m\"e\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"snapshot\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"w\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"avg\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"d\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[\u001b[0;39m30\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"f\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m"]
[12.701616, "o", "\"e\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"snapshot\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"w\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"sum-sq\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"d\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[\u001b[0;39m25\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"f\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m\"e\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"snapshot\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"w\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"d\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"f\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[\u001b[0;32m\"Infinity\"\u001b[0m\u001b[1;39m,\u001b[0;39m-0.0\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m\"e\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"snapshot\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"w\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"d\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[\u001b[0;39m7\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"f\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"step-8\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
