[11.251796, "o", "\r\n$ jq -c '{e:.event,w:.where,d:.data,f:.float,id:.id}' log/stacks.jsonl\r\n"]
[12.665062, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"e\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"hello\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"w\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"d\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"f\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m\"e\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"snapshot\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"w\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"d\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[\u001b[0;39m1\u001b[0m\u001b[1;39m,\u001b[0;39m2\u001b[0m\u001b[1;39m,\u001b[0;39m3\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"f\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[\u001b[0;39m1.5000000000000000\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[12.665105, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"e\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"snapshot\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"w\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"avg\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"d\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[\u001b[0;39m30\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"f\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m\"e\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"snapshot\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"w\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"sum-sq\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"d\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[\u001b[0;39m25\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"f\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m\"e\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"snapshot\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"w\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"d\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"f\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[\u001b[0;90mnull\u001b[0m\u001b[1;39m,\u001b[0;39m-0.0\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m\"e\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\""]
[12.665116, "o", "snapshot\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"w\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"d\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[\u001b[0;39m7\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"f\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"step-8\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
