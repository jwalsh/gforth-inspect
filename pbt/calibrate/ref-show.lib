# sourced by calibrate/*.sh (not itself a calibration: gmake globs *.sh)
# ref_show REF PATH: PATH at REF, from fixtures/refs/REF/ when that commit is
# no longer in the history (2026-11-22 scrub), else from git
ref_show() {
    _fixture="$(cd "$(dirname "$0")/.." && pwd)/fixtures/refs/$1/$(basename "$2")"
    if [ -f "$_fixture" ]; then cat "$_fixture"; else git -C "$(dirname "$0")" show "$1:$2"; fi
}

# under_test PATH: env/inspect.fs or contract/stacks-log.schema.json as
# gforth_run.py chooses it, so a plant edits what `check` runs: INSPECT_FS
# (SCHEMA_JSON for the schema), else INSPECT_REF, else this checkout's own
# file, uncommitted edits included
under_test() {
    case $1 in
        env/inspect.fs) _explicit=${INSPECT_FS:-} ;;
        *) _explicit=${SCHEMA_JSON:-} ;;
    esac
    if [ -n "$_explicit" ]; then cat "$_explicit"
    elif [ -n "${INSPECT_REF:-}" ]; then ref_show "$INSPECT_REF" "$1"
    else cat "$(cd "$(dirname "$0")/../.." && pwd)/$1"; fi
}
